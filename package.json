{
  "name": "universal-downloader",
  "version": "1.0.0",
  "description": "Cross-platform universal desktop downloader application",
  "main": "dist/main/index.js",
  "author": "Universal Downloader Team",
  "license": "MIT",
  "scripts": {
    "build:main": "esbuild src/main/index.ts src/main/preload.ts --bundle --platform=node --target=node20 --external:electron --external:ffmpeg-static --outdir=dist/main",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "build:win": "npm run build && electron-builder --win nsis",
    "dev:main": "npm run build:main",
    "dev": "npm run dev:main && concurrently -k -s first -n \"VITE,ELECTRON\" -c \"blue,magenta\" \"vite\" \"wait-on tcp:5173 && electron .\"",
    "start": "npm run dev",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\""
  },
  "build": {
    "appId": "com.universaldownloader.app",
    "productName": "Universal Downloader",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "universal-downloader",
      "repo": "universal-downloader"
    },
    "win": {
      "icon": "assets/icon.ico",
      "legalTrademarks": "Universal Downloader",
      "artifactName": "${productName} Setup ${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Universal Downloader",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yt-dlp-wrap": "^2.3.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
